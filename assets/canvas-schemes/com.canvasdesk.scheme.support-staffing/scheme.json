 "content_en": {
  "nodes": [
   {
    "id": "hint",
    "type": "text",
    "x": 0,
    "y": 40,
    "width": 360,
    "height": 240,
    "text": "Startup runway\nExpense items roll into the monthly burn, revenue offsets the net burn, and cash divided by it gives the runway.\nChange any item or the cash and everything recomputes. The “Costs → Burn” bundle opens with a click in the main stage.",
    "color": "4"
   },
   {
    "id": "demand",
    "type": "text",
    "x": 440,
    "y": 0,
    "width": 260,
    "height": 180,
    "text": "Calls\nUser calls per hour and the length of the hour.\n\ncalls = 240 req\nperiod = 1 h",
    "color": "5"
   },
   {
    "id": "service",
    "type": "text",
    "x": 440,
    "y": 240,
    "width": 260,
    "height": 180,
    "text": "Handling\nAverage operator time per call.\n\nhandle = 180 sec",
    "color": "5"
   },
   {
    "id": "staff",
    "type": "text",
    "x": 440,
    "y": 480,
    "width": 260,
    "height": 160,
    "text": "Staff\nAgents on the line per shift.\n\nagents = 15",
    "color": "5"
   },
   {
    "id": "flow",
    "type": "text",
    "x": 800,
    "y": 0,
    "width": 280,
    "height": 180,
    "text": "Flow\nCall intensity: calls divided by the hour.\n\nlambda = Calls.calls / Calls.period",
    "color": "2"
   },
   {
    "id": "speed",
    "type": "text",
    "x": 800,
    "y": 240,
    "width": 280,
    "height": 180,
    "text": "Speed\nOperator productivity: one call per handling time.\n\nmu = 1 req / Handling.handle",
    "color": "2"
   },
   {
    "id": "occupancy",
    "type": "text",
    "x": 1160,
    "y": 0,
    "width": 280,
    "height": 180,
    "text": "Occupancy\nShare of busy agents: values arrive in parameters by name.\n\nrho = utilization($lambda, $mu, $agents)",
    "color": "2"
   },
   {
    "id": "wait_prob",
    "type": "text",
    "x": 1160,
    "y": 240,
    "width": 280,
    "height": 180,
    "text": "Waiting\nShare of calls that will have to wait (Erlang C).\n\np_wait = erlang_c(Flow.lambda, Speed.mu, Staff.agents)",
    "color": "2"
   },
   {
    "id": "response",
    "type": "text",
    "x": 1160,
    "y": 480,
    "width": 280,
    "height": 180,
    "text": "Response\nAverage time from call arrival to completion (M/M/c model).\n\nwait = mmc(Flow.lambda, Speed.mu, Staff.agents)",
    "color": "2"
   },
   {
    "id": "wip",
    "type": "text",
    "x": 1520,
    "y": 0,
    "width": 280,
    "height": 180,
    "text": "Concurrent\nHow many calls sit in the system on average: Little’s law.\n\nwip = littles_law(Flow.lambda, Response.wait)",
    "color": "6"
   },
   {
    "id": "verdict",
    "type": "text",
    "x": 1520,
    "y": 240,
    "width": 320,
    "height": 220,
    "text": "Verdict\nThe horizon is 54 months at a net burn of 22 thousand per month: more than four years of headroom.\nRaise marketing and the runway shifts at once; a scenario on the items shows deltas without touching the base.",
    "color": "4"
   }
  ],
