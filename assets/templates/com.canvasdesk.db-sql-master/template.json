{
  "id": "com.canvasdesk.db-sql-master",
  "name_en": "DB SQL (master)",
  "name_ru": "БД SQL (мастер)",
  "version": "1.2.0",
  "category": "backend",
  "description": "Мастер БД: μ = 1 / query_time.",
  "description_en": "SQL master DB: μ = 1 / query_time.",
  "params": [
    {
      "name": "qps",
      "type": "rate",
      "default": 80,
      "unit": "rps",
      "min": 0
    },
    {
      "name": "query_time",
      "type": "time",
      "default": 10,
      "unit": "ms",
      "min": 0.001
    },
    {
      "name": "replicas",
      "type": "count",
      "default": 1,
      "min": 1,
      "max": 100
    },
    {
      "name": "replica_share",
      "type": "scalar",
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  ],
  "expr": "mm1($qps, 1 req / $query_time, $replicas)",
  "color": "#F5A623",
  "icon": "db",
  "outputs": [
    {
      "name": "replica_load",
      "unit": "rps",
      "expr": "$qps × $replica_share"
    },
    {
      "name": "capacity_qps",
      "unit": "rps",
      "expr": "1 req / $query_time × $replicas"
    },
    {
      "name": "utilization",
      "unit": "%",
      "expr": "utilization($qps, 1 req / $query_time, $replicas)"
    }
  ]
}
