{
  "id": "com.canvasdesk.tcp-lb",
  "name_en": "TCP Load Balancer",
  "name_ru": "TCP-балансировщик",
  "version": "1.2.0",
  "category": "network",
  "description": "L4-балансировщик TCP-соединений по серверам.",
  "description_en": "L4 balancer distributing TCP connections across servers.",
  "params": [
    {
      "name": "connections_per_sec",
      "type": "rate",
      "default": 800,
      "unit": "rps",
      "min": 0
    },
    {
      "name": "server_rate",
      "type": "rate",
      "default": 400,
      "unit": "rps",
      "min": 0
    },
    {
      "name": "servers",
      "type": "count",
      "default": 3,
      "min": 1,
      "max": 100
    },
    {
      "name": "auth_share",
      "type": "scalar",
      "default": 0.15,
      "min": 0,
      "max": 1
    },
    {
      "name": "feed_share",
      "type": "scalar",
      "default": 0.6,
      "min": 0,
      "max": 1
    },
    {
      "name": "media_share",
      "type": "scalar",
      "default": 0.25,
      "min": 0,
      "max": 1
    }
  ],
  "expr": "mm1($connections_per_sec, $server_rate, $servers)",
  "color": "#7ED321",
  "icon": "lb",
  "outputs": [
    {
      "name": "out_gateway",
      "unit": "rps",
      "expr": "$connections_per_sec"
    },
    {
      "name": "out_auth",
      "unit": "rps",
      "expr": "$connections_per_sec × $auth_share"
    },
    {
      "name": "out_feed",
      "unit": "rps",
      "expr": "$connections_per_sec × $feed_share"
    },
    {
      "name": "out_media",
      "unit": "rps",
      "expr": "$connections_per_sec × $media_share"
    },
    {
      "name": "utilization",
      "unit": "%",
      "expr": "utilization($connections_per_sec, $server_rate, $servers)"
    }
  ]
}
