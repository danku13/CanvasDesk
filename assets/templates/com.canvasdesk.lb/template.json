{
  "id": "com.canvasdesk.lb",
  "name_en": "Load Balancer",
  "name_ru": "Балансировщик нагрузки",
  "version": "1.1.0",
  "category": "backend",
  "description": "L7-балансировщик: модель M/M/c, время ответа кластера.",
  "description_en": "L7 load balancer: M/M/c cluster response time.",
  "params": [
    {
      "name": "rps",
      "type": "rate",
      "default": 1000,
      "unit": "rps",
      "min": 0
    },
    {
      "name": "service_rate",
      "type": "rate",
      "default": 1200,
      "unit": "rps",
      "min": 0
    },
    {
      "name": "servers",
      "type": "count",
      "default": 2,
      "min": 1,
      "max": 100
    }
  ],
  "expr": "mm1($rps, $service_rate, $servers)",
  "color": "#4A90E2",
  "icon": "lb",
  "outputs": [
    {
      "name": "next_hop_rps",
      "unit": "rps",
      "expr": "$connections_per_sec"
    },
    {
      "name": "effective_service_rate",
      "unit": "rps",
      "expr": "$server_rate × $servers"
    }
  ]
}
