{
  "id": "com.canvasdesk.ue-cagr",
  "name_en": "Compound Annual Growth Rate",
  "name_ru": "CAGR (среднегодовой темп роста)",
  "version": "1.0.0",
  "category": "unit-economics",
  "description": "CAGR: годовой темп роста за период; (end/begin)^(1/years) − 1.",
  "description_en": "CAGR: annualized growth rate; (end/begin)^(1/years) − 1.",
  "params": [
    {
      "name": "begin_value",
      "type": "scalar",
      "default": 100000,
      "unit": "usd",
      "min": 0.0001
    },
    {
      "name": "end_value",
      "type": "scalar",
      "default": 200000,
      "unit": "usd",
      "min": 0
    },
    {
      "name": "years",
      "type": "count",
      "default": 3,
      "min": 1,
      "max": 100
    }
  ],
  "expr": "cagr($begin_value, $end_value, $years)",
  "color": "#F5A623",
  "icon": "money"
}
