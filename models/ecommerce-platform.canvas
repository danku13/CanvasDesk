     "id": "com.canvasdesk.capacity-planner",
     "version": "1.0.0",
     "expr": "littles_law($rps, $response_time) / $concurrency_per_instance",
     "params": {
      "rps": {
       "num": 1111.11,
       "unit": "rps"
      },
      "response_time": {
       "num": 120,
       "unit": "ms"
