       "num": 50
      }
     },
     "icon": "worker",
     "color": "#4A90E2",
     "name": "Планировщик мощности",
     "outputs": [
      {
       "name": "concurrent_requests",
       "unit": "req",
       "expr": "littles_law($rps, $response_time)"
      },
      {
       "name": "fleet_with_70pct_headroom",
