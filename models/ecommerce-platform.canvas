      }
     ]
    },
    "title": "Каталог (gRPC)"
   }
  },
  {
   "id": "search",
   "type": "text",
   "text": "rps = 28 rps\ntimeout = 5 ms\nstream_window = 64 KB",
   "x": 2560,
   "y": 900,
   "width": 300.0,
   "height": 208,
   "color": "2",
   "canvasdesk": {
    "template": {
     "id": "com.canvasdesk.grpc-service",
     "version": "1.1.0",
     "expr": "mm1($rps, 1 req / $timeout)",
     "params": {
      "rps": {
       "num": 28,
       "unit": "rps"
      },
      "timeout": {
       "num": 5,
       "unit": "ms"
      },
      "stream_window": {
       "num": 64,
       "unit": "KB"
      }
     },
     "icon": "grpc",
     "color": "#7ED321",
     "name": "gRPC-сервис",
     "outputs": [
      {
       "name": "utilization",
       "unit": "%",
       "expr": "utilization($rps, 1 req / $timeout)"
      }
     ]
    },
    "title": "Поиск (gRPC)"
   }
  },
  {
   "id": "cart",
   "type": "text",
   "text": "qps = 21.7778 rps\nhit_rate = 0.85\neviction_latency = 0.2 ms",
   "x": 2560,
   "y": 1100,
   "width": 300.0,
   "height": 208,
   "color": "5",
   "canvasdesk": {
    "template": {
     "id": "com.canvasdesk.cache-redis",
     "version": "1.2.0",
     "expr": "mm1($qps × $hit_rate, 1 req / $eviction_latency)",
     "params": {
      "qps": {
       "num": 21.7778,
       "unit": "rps"
      },
      "hit_rate": {
       "num": 0.85
      },
      "eviction_latency": {
       "num": 0.2,
       "unit": "ms"
      }
     },
     "icon": "cache",
     "color": "#BD10E0",
     "name": "Кэш (Redis)",
     "outputs": [
      {
       "name": "hit_qps",
       "unit": "rps",
       "expr": "$qps × $hit_rate"
      },
      {
       "name": "miss_qps",
       "unit": "rps",
       "expr": "$qps × (1 - $hit_rate)"
      },
      {
       "name": "utilization",
       "unit": "%",
       "expr": "utilization($qps × $hit_rate, 1 req / $eviction_latency)"
      }
     ]
    },
    "title": "Корзина (Redis)"
   }
  },
  {
   "id": "wms",
   "type": "text",
   "text": "WMS\nWarehouse Management: линии заказов на отборку, сборщики — каналы обслуживания (Эрланг C). Штат масштабируется операционно, не инстансами.\n\nlines_rps = OMS.order_rps × Допущения.items_per_order\npick_time = 90 sec\npickers = 70\nwait_prob = erlang_c(lines_rps, 1 req / pick_time, pickers)\nrho = utilization(lines_rps, 1 req / pick_time, pickers)\npickers_needed = littles_law(lines_rps, pick_time) / 1 req / 0.85\nbg_rps = lines_rps × 2 + OMS.events_rps",
   "x": 2080,
   "y": 1120,
   "width": 380,
   "height": 400,
   "color": "1"
  },
  {
   "id": "tms",
   "type": "text",
   "text": "TMS\nTransportation Management: посылки в пути (закон Литтла) и курьеры на последний километр.\n\nshipments_rps = OMS.order_rps × 0.98\ntransit_time = 36 h\nin_transit = littles_law(shipments_rps, transit_time)\nparcels_per_courier_day = 80\ncouriers = littles_law(shipments_rps, 86400 sec) / parcels_per_courier_day\ncouriers_needed = couriers / 0.85",
   "x": 3040,
   "y": 640,
   "width": 360,
   "height": 330,
   "color": "1"
  },
  {
   "id": "erp",
   "type": "text",
   "text": "ERP\nСинхронизация со справочниками и учётом: сток по SKU, проводки по заказам. Батчевые джобы поверх шины.\n\nstock_sync_rps = Допущения.sku_count × 1 req / 4 h\nledger_rps = OMS.order_rps × 2\ntotal_rps = stock_sync_rps + ledger_rps\nwait = mmc(total_rps, 1 req / 200 ms, 4)\nrho = utilization(total_rps, 1 req / 200 ms, 4)",
   "x": 3040,
   "y": 1040,
   "width": 360,
   "height": 330,
   "color": "1"
  },
  {
   "id": "support",
   "type": "text",
   "text": "calls_per_sec = 0.009259 rps\nhandle_time = 360 sec\nagents = 4",
   "x": 3040,
   "y": 1440,
   "width": 300.0,
   "height": 208,
   "color": "1",
   "canvasdesk": {
    "template": {
     "id": "com.canvasdesk.support-staffing",
     "version": "1.0.0",
     "expr": "erlang_c($calls_per_sec, 1 req / $handle_time, $agents)",
     "params": {
      "calls_per_sec": {
       "num": 0.00925926,
       "unit": "rps"
      },
      "handle_time": {
       "num": 360,
       "unit": "sec"
      },
      "agents": {
       "num": 4
      }
     },
     "icon": "users",
     "color": "#4A90E2",
     "name": "Штат поддержки (Эрланг C)",
     "outputs": [
      {
       "name": "utilization",
       "unit": "%",
       "expr": "utilization($calls_per_sec, 1 req / $handle_time, $agents)"
      }
     ]
    },
    "title": "Поддержка (Erlang C)"
   }
  },
  {
   "id": "queue",
   "type": "text",
   "text": "produce_rate = 1.38889 rps\npartition_consume = 100 rps\npartitions = 3\nretention = 168 h",
   "x": 2080,
   "y": 1720,
   "width": 360.0,
   "height": 234,
   "color": "4",
   "canvasdesk": {
    "template": {
     "id": "com.canvasdesk.queue-kafka",
     "version": "1.2.0",
     "expr": "mm1($produce_rate / $partitions, $partition_consume)",
     "params": {
      "produce_rate": {
       "num": 1.38889,
       "unit": "rps"
      },
      "partition_consume": {
       "num": 100,
       "unit": "rps"
      },
      "partitions": {
       "num": 3
      },
      "retention": {
       "num": 168,
       "unit": "h"
      }
     },
     "icon": "queue",
     "color": "#9013FE",
     "name": "Очередь (Kafka)",
     "outputs": [
      {
       "name": "consume_rate",
       "unit": "rps",
       "expr": "min($produce_rate, $partition_consume × $partitions)"
      },
      {
       "name": "utilization",
       "unit": "%",
       "expr": "utilization($produce_rate / $partitions, $partition_consume)"
      }
     ]
    },
    "title": "Шина заказов (Kafka)"
   }
  },
