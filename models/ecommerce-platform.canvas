   "y": 300,
   "width": 300.0,
   "height": 208,
   "color": "2",
   "canvasdesk": {
    "template": {
     "id": "com.canvasdesk.grpc-service",
     "version": "1.1.0",
     "expr": "mm1($rps, 1 req / $timeout)",
     "params": {
      "rps": {
       "num": 0.277778,
       "unit": "rps"
      },
      "timeout": {
       "num": 100,
       "unit": "ms"
      },
      "stream_window": {
       "num": 64,
       "unit": "KB"
      }
     },
     "icon": "grpc",
     "color": "#7ED321",
     "name": "gRPC-сервис",
     "outputs": [
      {
       "name": "utilization",
       "unit": "%",
