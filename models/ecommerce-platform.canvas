       "expr": "utilization($rps, 1 req / $token_verify)"
      }
     ]
    },
    "title": "Auth-сервис"
   }
  },
  {
   "id": "catalog",
   "type": "text",
   "text": "rps = 62.2222 rps\ntimeout = 2 ms\nstream_window = 64 KB",
   "x": 2560,
   "y": 700,
   "width": 300.0,
   "height": 208,
   "color": "2",
   "canvasdesk": {
    "template": {
     "id": "com.canvasdesk.grpc-service",
     "version": "1.1.0",
     "expr": "mm1($rps, 1 req / $timeout)",
     "params": {
      "rps": {
       "num": 62.2222,
       "unit": "rps"
      },
      "timeout": {
       "num": 2,
       "unit": "ms"
      },
      "stream_window": {
       "num": 64,
       "unit": "KB"
      }
     },
     "icon": "grpc",
